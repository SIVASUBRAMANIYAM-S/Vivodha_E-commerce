# Copy to .env. The owner commits public client configuration; never put secret / service-role keys here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
# Optional HTTPS WebView origin. Defaults to the Supabase URL; allowlist that hostname in Turnstile.
EXPO_PUBLIC_TURNSTILE_ORIGIN=
# Optional DEV-only exception, off by default. Set true only in ignored .env.local.
# Requires Supabase DEV CAPTCHA OFF and username-login DEV_DISABLE_CAPTCHA=true.
# Ignored outside development builds and outside the known DEV project.
EXPO_PUBLIC_DEV_DISABLE_CAPTCHA=false
