# Copy to .env (committed to git, ADR-122 — client-safe values only, never
# secret/service-role keys).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Cloudflare Turnstile PUBLIC site key (not the secret key — that stays only
# in Supabase Auth → Attack Protection). Paste your own value into .env.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=
