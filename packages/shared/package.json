{
  "name": "@vivodha/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, zod schemas, constants and design tokens (TS source, no build step)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens/index.ts",
    "./constants": "./src/constants/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./types": "./src/types/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vivodha/config": "workspace:*",
    "eslint": "^9.39.0",
    "typescript": "~6.0.3"
  }
}
